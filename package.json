{
  "name": "did",
  "description": "the calendar is your timesheet",
  "version": "0.21.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "url": "https://github.com/Puzzlepart/did"
  },
  "bugs": {
    "url": "https://github.com/Puzzlepart/did/issues"
  },
  "ava": {
    "workerThreads": true,
    "timeout": "2m",
    "extensions": {
      "ts": "commonjs"
    },
    "require": [
      "ts-node/register"
    ],
    "nodeArguments": [
      "--no-warnings"
    ]
  },
  "config": {
    "BUNDLE_FILE_NAME": "did.[name].[fullhash].js"
  },
  "scripts": {
    "docker:start": "./scripts/docker.sh start",
    "docker:stop": "./scripts/docker.sh stop",
    "docker:logs": "./scripts/docker.sh logs",
    "docker:shell": "./scripts/docker.sh shell",
    "docker:db": "./scripts/docker.sh db",
    "docker:redis": "./scripts/docker.sh redis",
    "docker:status": "./scripts/docker.sh status",
    "docker:clean": "./scripts/docker.sh clean",
    "docker:maintenance": "./scripts/docker.sh maintenance",
    "docker:rebuild:watch": "docker compose up --build -d did && docker compose logs -f did",
    "docker:watch": "docker compose up -d did && docker compose logs -f did",
    "watch": "node .tasks/watch.js",
    "prepare": "node -e \"const { spawnSync } = require('child_process'); const result = spawnSync('git', ['config', 'core.hooksPath', '.githooks'], { stdio: 'inherit' }); if (result.error && result.error.code !== 'ENOENT') { process.exit(1); }\"",
    "package": "node .tasks/package.js",
    "lint": "eslint --ext .ts,.tsx ./client ./server --color --quiet",
    "lint:fix": "eslint --ext .ts,.tsx ./client ./server --color --quiet --fix",
    "prettier": " prettier '**/*.ts*' --log-level silent",
    "prettier:write": "prettier '**/*.ts*' --log-level silent --write",
    "test": "ava --verbose",
    "start": "node ./server/index.js",
    "package:client": "webpack --config webpack/config.js",
    "build:server": "tsc --project tsconfig.json && copyfiles -u 1 \"server/public/**/*\" dist/server",
    "debug:server": "npm run build:server; ts-node ./server/index.ts -T --inspect --wait",
    "create-env": "node .tasks/createDotEnv.js",
    "tag": "node .tasks/git-tag.js",
    "update:version": "node .tasks/updateVersion.js",
    "update:version:minor": "npm run update:version -- --minor"
  },
